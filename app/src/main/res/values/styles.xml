<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tombol sekunder tonal (seragam TDM): primary_container + teks primary. -->
    <style name="TasirinBtn">
        <item name="android:background">@drawable/bg_btn_tv</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <!-- Tombol utama: berisi warna brand, teks adaptif siang/malam via btn_primary_text. -->
    <style name="TasirinBtnPrimary" parent="TasirinBtn">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TasirinBtnSmall" parent="TasirinBtn">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <!-- Tombol di atas hero gradien: kaca tembus pandang, teks putih. -->
    <style name="TasirinBtnHero" parent="TasirinBtnSmall">
        <item name="android:background">@drawable/bg_btn_hero</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Alias nama Tasirin Download Manager agar layout bersama
         bisa dipakai di kedua aplikasi tanpa ubah nama style. -->
    <style name="AppButton" parent="TasirinBtnPrimary" />
    <style name="TvOutlinedButton" parent="TasirinBtn" />
    <style name="AppInput" parent="TasirinInput" />

    <style name="TasirinInput">
        <item name="android:background">@drawable/bg_input_tv</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Judul seksi kartu: warna brand agar hirarki jelas. -->
    <style name="TasirinSection">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="TasirinLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Sub-judul dalam kartu: pemisah grup pengaturan, lebih kecil dari seksi. -->
    <style name="TasirinSub">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Teks bantuan kecil di bawah judul kartu. -->
    <style name="TasirinHint">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Teks di atas hero gradien. -->
    <style name="TasirinHeroTitle">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Teks info (URL, rincian versi) di kotak info. -->
    <style name="TasirinInfo">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- Kotak centang: teks seukuran tombol, area sentuh 48dp, fokus D-pad jelas. -->
    <style name="TasirinCheck">
        <item name="android:background">@drawable/item_focus_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- Pemisah grup: garis 1dp konsisten di semua kartu Settings. -->
    <style name="TasirinDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@color/card_stroke</item>
    </style>

    <!-- Kartu baku semua layar (radius+elevasi satu pintu via bg_card).
         Varian ramping (pengaturan/landscape) pakai gaya ini + padding 12dp. -->
    <style name="TasirinCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
