<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol Stop: ring aksen 3dp saat fokus D-pad agar seragam dan jelas. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/status_off" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <!-- Merah tua adaptif siang/malam saat tombol Stop ditekan. -->
            <solid android:color="@color/btn_stop_pressed" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/status_off" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
