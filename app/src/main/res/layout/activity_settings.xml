<?xml version="1.0" encoding="utf-8"?>
<!-- Kerangka utama: tiap kartu dipecah ke main_card_*.xml agar lint TooManyViews bersih
     (satu layout >80 view). findViewById tetap bekerja karena <include> di-inflate sama.
     Bilah Start/Stop + Buka menempel di bawah agar tak perlu scroll setelah ubah pengaturan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:paddingStart="@dimen/side_padding"
            android:paddingEnd="@dimen/side_padding">

        <Button
            android:id="@+id/settingsBack"
            android:nextFocusDown="@id/aboutBtn"
            style="@style/TasirinBtnSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="0dp"
            android:text="@string/back" />

        <!-- Hero: identitas app di atas gradien brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:focusable="false"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    style="@style/TasirinHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/TasirinHeroSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline" />
            </LinearLayout>

            <Button
                android:id="@+id/aboutBtn"
                android:nextFocusDown="@id/simpleMode"
                android:nextFocusUp="@id/settingsBack"
                style="@style/TasirinBtnHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about" />
        </LinearLayout>

        <!-- Filter global: bukan pengaturan server, jadi di luar kartu Server -->
        <CheckBox
            android:id="@+id/simpleMode"
            android:nextFocusDown="@id/startStop"
            android:nextFocusUp="@id/aboutBtn"
            android:background="@drawable/item_focus_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mode_simple" />

        <!-- Rincian versi, DB & storage (teks panjang dari MainActivity) -->
        <TextView
            android:id="@+id/version"
            style="@style/TasirinInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_info_box"
            android:padding="12dp" />

        <!-- ===================== SERVER (esensial saja) ===================== -->
        <include layout="@layout/main_card_server" />

        <!-- ===================== LANJUTAN (collapsible) ===================== -->
        <Button
            android:id="@+id/advancedToggle"
            android:nextFocusDown="@id/pinInput"
            android:nextFocusUp="@id/port"
            style="@style/TasirinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/advanced_open" />

        <LinearLayout
            android:id="@+id/advancedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Keamanan: Admin Token + PIN -->
            <include layout="@layout/main_card_security" />

            <!-- Pembaruan & Sertifikat (gabungan Pengaturan + Pemeliharaan) -->
            <include layout="@layout/main_card_maintenance" />

            <!-- Backup Telegram -->
            <include layout="@layout/main_card_telegram" />

            <!-- Log -->
            <include layout="@layout/main_card_log" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/startStopBawah"
            android:nextFocusUp="@id/logOpen"
            android:nextFocusRight="@id/bukaBawah"
            style="@style/TasirinBtnPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start" />

        <Button
            android:id="@+id/bukaBawah"
            android:nextFocusUp="@id/logOpen"
            android:nextFocusLeft="@id/startStopBawah"
            style="@style/TasirinBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/open_web_ui" />
    </LinearLayout>
</LinearLayout>
