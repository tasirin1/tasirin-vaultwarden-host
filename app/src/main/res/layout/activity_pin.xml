<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman login PIN (portrait): kartu tengah + brand + kolom PIN.
     Rantai nextFocus* dijaga untuk D-pad TV.
     Varian landscape ada di res/layout-land/activity_pin.xml (ID sama). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="480dp"
        android:orientation="vertical"
        android:padding="@dimen/side_padding">

        <LinearLayout
            style="@style/TasirinCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/app_name"
                    android:focusable="false"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    style="@style/TasirinHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name" />
            </LinearLayout>

            <TextView
                style="@style/TasirinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pin_login_judul" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pin_login_pesan"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pinInput"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pin_hint_masuk"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:nextFocusDown="@id/pinBuka" />

            <TextView
                android:id="@+id/pinError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="20dp"
                android:textColor="@color/log_error"
                android:textSize="13sp" />

            <Button
                android:id="@+id/pinBuka"
                style="@style/TasirinBtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nextFocusDown="@id/pinKeluar"
                android:nextFocusUp="@id/pinInput"
                android:text="@string/pin_buka" />

            <Button
                android:id="@+id/pinKeluar"
                style="@style/TasirinBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nextFocusUp="@id/pinBuka"
                android:text="@string/pin_keluar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
