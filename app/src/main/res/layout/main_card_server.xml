<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu utama: status + kontrol server. ID dan rantai nextFocus* dijaga
     agar navigasi D-pad TV tidak berubah. -->
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TasirinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_stopped"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/stopped"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/startStop"
                    android:nextFocusDown="@id/copyUrl"
                    android:nextFocusUp="@id/aboutBtn"
                    style="@style/TasirinBtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/start" />
            </LinearLayout>

            <TextView
                android:id="@+id/restartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_changed_hint"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_available_hint"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/netInfo"
                style="@style/TasirinInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_box"
                android:padding="12dp" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyUrl"
                    android:nextFocusDown="@id/qrBtn"
                    android:nextFocusUp="@id/startStop"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy_url" />

                <Button
                    android:id="@+id/qrBtn"
                    android:nextFocusDown="@id/statusWeb"
                    android:nextFocusUp="@id/copyUrl"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/qr" />

                <Button
                    android:id="@+id/statusWeb"
                    android:nextFocusDown="@id/dataDir"
                    android:nextFocusUp="@id/qrBtn"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/status_web" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/card_stroke" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/folder_data" />

            <EditText
                android:id="@+id/dataDir"
                android:nextFocusDown="@id/port"
                android:nextFocusUp="@id/copyUrl"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_data_dir"
                android:inputType="text" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port" />

            <EditText
                android:id="@+id/port"
                android:nextFocusDown="@id/open"
                android:nextFocusUp="@id/dataDir"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_port"
                android:inputType="number" />

            <Button
                android:id="@+id/open"
                android:nextFocusDown="@id/advancedToggle"
                android:nextFocusUp="@id/port"
                style="@style/TasirinBtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/open_web_ui" />
        </LinearLayout>
