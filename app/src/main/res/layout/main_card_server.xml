<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu Server (esensial): status + Start + URL + folder/port.
     Admin Token/PIN pindah ke main_card_security; cadangan ke Telegram. -->
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:scrollHorizontally="true"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_stopped"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/stopped"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/unduhBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/restartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_changed_hint"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_available_hint"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/netInfo"
                style="@style/TasirinInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_url_box"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/copy_url"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:nextFocusUp="@id/headerServer"
                android:nextFocusDown="@id/copyUrl"
                android:padding="12dp" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyUrl"
                    android:drawableStart="@drawable/ic_globe"
                    android:drawablePadding="8dp"
                    android:nextFocusDown="@id/copyLoopback"
                    android:nextFocusRight="@id/copyLoopback"
                    android:nextFocusUp="@id/netInfo"
                    style="@style/TasirinBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy_url_lan" />

                <Button
                    android:id="@+id/copyLoopback"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawablePadding="8dp"
                    android:nextFocusDown="@id/dataDir"
                    android:nextFocusLeft="@id/copyUrl"
                    android:nextFocusUp="@id/copyUrl"
                    style="@style/TasirinBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/copy_url_hp" />

            </LinearLayout>

            <View style="@style/TasirinDivider" />

            <TextView
                style="@style/TasirinSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_koneksi" />

            <TextView
                android:id="@+id/labelDataDir"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/folder_data" />

            <EditText
                android:id="@+id/dataDir"
                android:nextFocusDown="@id/port"
                android:nextFocusUp="@id/copyLoopback"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_data_dir"
                android:inputType="text" />

            <TextView
                android:id="@+id/dataDirError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/labelPort"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port" />

            <EditText
                android:id="@+id/port"
                android:nextFocusDown="@id/adminToken"
                android:nextFocusUp="@id/dataDir"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_port"
                android:inputType="number" />

            <TextView
                android:id="@+id/portError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
