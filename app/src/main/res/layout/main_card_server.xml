<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu Server (esensial): status + Start + URL + folder/port.
     Admin Token/PIN pindah ke main_card_security; cadangan ke Telegram. -->
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/accent_server" />

            <TextView
                style="@style/TasirinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_title_server" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_stopped"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/stopped"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/startStop"
                    android:nextFocusDown="@id/copyUrl"
                    android:nextFocusUp="@id/simpleMode"
                    style="@style/TasirinBtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/start" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/unduhBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/restartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_changed_hint"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_available_hint"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/netInfo"
                style="@style/TasirinInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_box"
                android:padding="12dp" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/copyUrl"
                    android:nextFocusDown="@id/copyLoopback"
                    android:nextFocusUp="@id/startStop"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_url_lan" />

                <Button
                    android:id="@+id/copyLoopback"
                    android:nextFocusDown="@id/dataDir"
                    android:nextFocusUp="@id/copyUrl"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/copy_url_hp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/card_stroke" />

            <TextView
                style="@style/TasirinSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_koneksi" />

            <TextView
                android:id="@+id/labelDataDir"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/folder_data" />

            <EditText
                android:id="@+id/dataDir"
                android:nextFocusDown="@id/port"
                android:nextFocusUp="@id/copyLoopback"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_data_dir"
                android:inputType="text" />

            <TextView
                android:id="@+id/dataDirError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/labelPort"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port" />

            <EditText
                android:id="@+id/port"
                android:nextFocusDown="@id/adminToken"
                android:nextFocusUp="@id/dataDir"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_port"
                android:inputType="number" />

            <TextView
                android:id="@+id/portError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
