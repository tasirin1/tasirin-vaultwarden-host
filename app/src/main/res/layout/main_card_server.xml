<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu utama: status + kontrol server + pengaturan esensial (folder, port,
     admin token, PIN, cadangan cepat). ID dan rantai nextFocus* dijaga
     agar navigasi D-pad TV tidak berubah. -->
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/accent_server" />

            <TextView
                style="@style/TasirinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_title_server" />

            <CheckBox
                android:id="@+id/simpleMode"
                android:nextFocusDown="@id/startStop"
                android:nextFocusUp="@id/aboutBtn"
                android:background="@drawable/item_focus_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_simple" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_stopped"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/stopped"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/startStop"
                    android:nextFocusDown="@id/copyUrl"
                    android:nextFocusUp="@id/simpleMode"
                    style="@style/TasirinBtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/start" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/unduhBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/restartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_changed_hint"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_available_hint"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/netInfo"
                style="@style/TasirinInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_box"
                android:padding="12dp" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/copyUrl"
                    android:nextFocusDown="@id/copyLoopback"
                    android:nextFocusUp="@id/startStop"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_url_lan" />

                <Button
                    android:id="@+id/copyLoopback"
                    android:nextFocusDown="@id/dataDir"
                    android:nextFocusUp="@id/copyUrl"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/copy_url_hp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/card_stroke" />

            <TextView
                style="@style/TasirinSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_koneksi" />

            <TextView
                android:id="@+id/labelDataDir"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/folder_data" />

            <EditText
                android:id="@+id/dataDir"
                android:nextFocusDown="@id/port"
                android:nextFocusUp="@id/copyLoopback"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_data_dir"
                android:inputType="text" />

            <TextView
                android:id="@+id/dataDirError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/labelPort"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port" />

            <EditText
                android:id="@+id/port"
                android:nextFocusDown="@id/adminToken"
                android:nextFocusUp="@id/dataDir"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_port"
                android:inputType="number" />

            <TextView
                android:id="@+id/portError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/card_stroke" />

            <TextView
                style="@style/TasirinSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_akses_cepat" />

            <TextView
                android:id="@+id/labelAdmin"
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/admin_token" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/adminToken"
                    android:nextFocusDown="@id/showAdmin"
                    android:nextFocusUp="@id/port"
                    style="@style/TasirinInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/admin_token_hint"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/showAdmin"
                    android:nextFocusDown="@id/pinInput"
                    android:nextFocusUp="@id/adminToken"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/show" />

                <Button
                    android:id="@+id/randomAdmin"
                    android:nextFocusDown="@id/pinInput"
                    android:nextFocusUp="@id/adminToken"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/acak" />
            </LinearLayout>

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pin_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/pinInput"
                    android:nextFocusDown="@id/pinEnabled"
                    android:nextFocusUp="@id/adminToken"
                    style="@style/TasirinInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/pin_hint"
                    android:inputType="numberPassword" />

                <CheckBox
                    android:id="@+id/pinEnabled"
                    android:nextFocusDown="@id/backupDb"
                    android:nextFocusUp="@id/pinInput"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/active" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/card_stroke" />

            <TextView
                style="@style/TasirinSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sub_cadang_cepat" />

            <Button
                android:id="@+id/backupDb"
                android:nextFocusDown="@id/backupTg"
                android:nextFocusUp="@id/pinEnabled"
                style="@style/TasirinBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/backup_local" />

            <Button
                android:id="@+id/backupTg"
                android:nextFocusDown="@id/open"
                android:nextFocusUp="@id/backupDb"
                style="@style/TasirinBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/backup_to_tg" />

            <Button
                android:id="@+id/open"
                android:nextFocusDown="@id/advancedToggle"
                android:nextFocusUp="@id/backupTg"
                style="@style/TasirinBtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/open_web_ui" />
        </LinearLayout>
