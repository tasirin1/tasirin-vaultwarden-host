<?xml version="1.0" encoding="utf-8"?>
<!-- Layar awal portrait: brand ringkas + kartu info + kartu server (banner
     status full-width) + kartu log collapsible + footer Start full-width
     sticky. Rantai nextFocus* dijaga untuk D-pad TV; rantai yang melewati
     updateBtn yang kadang gone diperbaiki dinamis di MainActivity.
     Varian landscape ada di res/layout-land/activity_main.xml (ID sama). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="@dimen/side_padding"
            android:paddingEnd="@dimen/side_padding">

            <!-- Hero ringkas: ikon + judul + titik tiga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_name"
                    android:focusable="false"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:id="@+id/appTitle"
                    style="@style/TasirinHeroTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/app_name" />

                <Button
                    android:id="@+id/overflowBtn"
                    android:nextFocusDown="@id/netInfo"
                    android:nextFocusUp="@id/startStop"
                    style="@style/TasirinBtnHero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/menu"
                    android:text="@string/overflow" />
            </LinearLayout>

            <!-- ===================== INFO ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/version"
                    style="@style/TasirinInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/netInfo"
                    android:nextFocusDown="@id/updateBtn"
                    android:nextFocusUp="@id/overflowBtn"
                    style="@style/TasirinInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_url_box"
                    android:clickable="true"
                    android:contentDescription="@string/copy_url"
                    android:focusable="true"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/uptimeInfo"
                    style="@style/TasirinInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===================== SERVER ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/server_title" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_status_stopped"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/stopped"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/restartHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_changed_hint"
                    android:textColor="@color/status_off"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/updateBtn"
                    android:nextFocusDown="@id/logToggle"
                    android:nextFocusUp="@id/netInfo"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/update_available_hint"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===================== LOG REALTIME ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TasirinSection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:text="@string/log_realtime" />

                    <Button
                        android:id="@+id/logToggle"
                        android:nextFocusDown="@id/homeSaveLog"
                        android:nextFocusUp="@id/updateBtn"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/collapse" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeLogCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/log_lines_initial"
                    android:textSize="11sp" />

                <!-- Pratinjau log scroll mandiri (autoscroll via kode): abaikan NestedScrolling. -->
                <ScrollView
                    android:id="@+id/homeLogScroll"
                    tools:ignore="NestedScrolling"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_info_box">

                    <TextView
                        android:id="@+id/homeLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:textSize="11sp" />
                </ScrollView>

                <Button
                    android:id="@+id/homeSaveLog"
                    android:nextFocusDown="@id/startStop"
                    android:nextFocusUp="@id/logToggle"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/save_txt" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer sticky: Start/Stop full-width selalu terlihat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/startStop"
            android:nextFocusDown="@id/overflowBtn"
            android:nextFocusUp="@id/homeSaveLog"
            style="@style/TasirinBtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start" />
    </LinearLayout>
</LinearLayout>
