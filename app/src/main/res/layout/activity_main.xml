<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/aboutBtn"
                android:nextFocusDown="@id/startStop"
                android:nextFocusUp="@id/logOpen"
                style="@style/TasirinBtnSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/about" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <!-- ===================== SERVER ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_stopped"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/stopped"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/startStop"
                    android:nextFocusDown="@id/copyUrl"
                    android:nextFocusUp="@id/aboutBtn"
                    style="@style/TasirinBtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/start" />
            </LinearLayout>

            <TextView
                android:id="@+id/netInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyUrl"
                    android:nextFocusDown="@id/qrBtn"
                    android:nextFocusUp="@id/startStop"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy_url" />

                <Button
                    android:id="@+id/qrBtn"
                    android:nextFocusDown="@id/statusWeb"
                    android:nextFocusUp="@id/copyUrl"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/qr" />

                <Button
                    android:id="@+id/statusWeb"
                    android:nextFocusDown="@id/dataDir"
                    android:nextFocusUp="@id/qrBtn"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/status_web" />
            </LinearLayout>

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/folder_data" />

            <EditText
                android:id="@+id/dataDir"
                android:nextFocusDown="@id/port"
                android:nextFocusUp="@id/copyUrl"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_data_dir"
                android:inputType="text" />

            <TextView
                style="@style/TasirinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/port" />

            <EditText
                android:id="@+id/port"
                android:nextFocusDown="@id/open"
                android:nextFocusUp="@id/dataDir"
                style="@style/TasirinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/default_port"
                android:inputType="number" />

            <TextView
                android:id="@+id/restartHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_changed_hint"
                android:textColor="@color/status_off"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/update_available_hint"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/open"
                android:nextFocusDown="@id/advancedToggle"
                android:nextFocusUp="@id/port"
                style="@style/TasirinBtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_web_ui" />
        </LinearLayout>

        <!-- ===================== LANJUTAN (collapsible) ===================== -->
        <Button
            android:id="@+id/advancedToggle"
            android:nextFocusDown="@id/adminToken"
            android:nextFocusUp="@id/open"
            style="@style/TasirinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/advanced_open" />

        <LinearLayout
            android:id="@+id/advancedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Pengaturan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_token" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/adminToken"
                        android:nextFocusDown="@id/showAdmin"
                        android:nextFocusUp="@id/advancedToggle"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/admin_token_hint"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/showAdmin"
                        android:nextFocusDown="@id/autoStart"
                        android:nextFocusUp="@id/adminToken"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/show" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/autoStart"
                    android:nextFocusDown="@id/https"
                    android:nextFocusUp="@id/showAdmin"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auto_start_boot" />

                <CheckBox
                    android:id="@+id/https"
                    android:nextFocusDown="@id/pinInput"
                    android:nextFocusUp="@id/autoStart"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/https_self_signed" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pin_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/pinInput"
                        android:nextFocusDown="@id/pinEnabled"
                        android:nextFocusUp="@id/https"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/pin_hint"
                        android:inputType="numberPassword" />

                    <CheckBox
                        android:id="@+id/pinEnabled"
                        android:nextFocusDown="@id/batteryBtn"
                        android:nextFocusUp="@id/pinInput"
                        android:background="@drawable/item_focus_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/active" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/batteryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_not_allowed"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/batteryBtn"
                        android:nextFocusDown="@id/autoUpdate"
                        android:nextFocusUp="@id/pinEnabled"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pemeliharaan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maintenance" />

                <CheckBox
                    android:id="@+id/autoUpdate"
                    android:nextFocusDown="@id/autoUpdateWv"
                    android:nextFocusUp="@id/batteryBtn"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auto_update_binary" />

                <CheckBox
                    android:id="@+id/autoUpdateWv"
                    android:nextFocusDown="@id/autoRestart"
                    android:nextFocusUp="@id/autoUpdate"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auto_update_webvault" />

                <CheckBox
                    android:id="@+id/autoRestart"
                    android:nextFocusDown="@id/update"
                    android:nextFocusUp="@id/autoUpdateWv"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auto_restart_update" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/update"
                        android:nextFocusDown="@id/revert"
                        android:nextFocusUp="@id/autoRestart"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/check_update" />

                    <Button
                        android:id="@+id/revert"
                        android:nextFocusDown="@id/cert"
                        android:nextFocusUp="@id/update"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/reset_binary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cert"
                        android:nextFocusDown="@id/installCert"
                        android:nextFocusUp="@id/revert"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cert" />

                    <Button
                        android:id="@+id/installCert"
                        android:nextFocusDown="@id/exportCfg"
                        android:nextFocusUp="@id/cert"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/install_cert" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/exportCfg"
                        android:nextFocusDown="@id/importCfg"
                        android:nextFocusUp="@id/installCert"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/export_config" />

                    <Button
                        android:id="@+id/importCfg"
                        android:nextFocusDown="@id/updateWv"
                        android:nextFocusUp="@id/exportCfg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/import_config" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/updateWv"
                        android:nextFocusDown="@id/backupDb"
                        android:nextFocusUp="@id/importCfg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/update_web_vault" />

                    <Button
                        android:id="@+id/backupDb"
                        android:nextFocusDown="@id/restoreDb"
                        android:nextFocusUp="@id/updateWv"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/backup_local" />
                </LinearLayout>

                <Button
                    android:id="@+id/restoreDb"
                    android:nextFocusDown="@id/tgToken"
                    android:nextFocusUp="@id/backupDb"
                    style="@style/TasirinBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/restore_db" />
            </LinearLayout>

            <!-- Backup Telegram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_telegram" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bot_token" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/tgToken"
                        android:nextFocusDown="@id/showTg"
                        android:nextFocusUp="@id/restoreDb"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/bot_token_hint"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/showTg"
                        android:nextFocusDown="@id/tgChat"
                        android:nextFocusUp="@id/tgToken"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/show" />
                </LinearLayout>

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_id" />

                <EditText
                    android:id="@+id/tgChat"
                    android:nextFocusDown="@id/backupPass"
                    android:nextFocusUp="@id/showTg"
                    style="@style/TasirinInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/chat_id_hint"
                    android:inputType="text" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_pass_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/backupPass"
                        android:nextFocusDown="@id/showPass"
                        android:nextFocusUp="@id/tgChat"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/showPass"
                        android:nextFocusDown="@id/tgAuto"
                        android:nextFocusUp="@id/backupPass"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/show" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/tgAuto"
                    android:nextFocusDown="@id/backupOnStart"
                    android:nextFocusUp="@id/showPass"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/backup_auto_24h" />

                <CheckBox
                    android:id="@+id/backupOnStart"
                    android:nextFocusDown="@id/tgFull"
                    android:nextFocusUp="@id/tgAuto"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_auto_on_start" />

                <CheckBox
                    android:id="@+id/tgFull"
                    android:nextFocusDown="@id/backupTg"
                    android:nextFocusUp="@id/backupOnStart"
                    android:background="@drawable/item_focus_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/backup_include_settings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/backupTg"
                        android:nextFocusDown="@id/restoreTg"
                        android:nextFocusUp="@id/backupOnStart"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_to_tg" />

                    <Button
                        android:id="@+id/restoreTg"
                        android:nextFocusDown="@id/logOpen"
                        android:nextFocusUp="@id/backupTg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/restore_from_tg" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tg_bot_info"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/log_realtime" />

                <Button
                    android:id="@+id/logOpen"
                    android:nextFocusDown="@id/startStop"
                    android:nextFocusUp="@id/restoreTg"
                    style="@style/TasirinBtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_log_full" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
