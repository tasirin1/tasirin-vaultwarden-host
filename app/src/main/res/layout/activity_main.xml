<?xml version="1.0" encoding="utf-8"?>
<!-- Layar awal portrait: brand ringkas + kartu info (tautan) di atas
     + kartu log realtime di tengah + footer sticky (banner status
     di atas tombol Start/Stop). Rantai nextFocus* dijaga untuk D-pad TV; rantai yang melewati
     updateBtn yang kadang gone diperbaiki dinamis di MainActivity.
     Varian landscape ada di res/layout-land/activity_main.xml (ID sama). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<!-- Baris judul ala Toolbar TDM: primary solid setinggi action bar,
         judul + subversi putih, ikon titik-tiga vektor di kanan. Tetap di
         atas (di luar ScrollView) seperti Toolbar TDM. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                android:background="@color/primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TasirinToolbarTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/toolbarSubtitle"
                        style="@style/TasirinToolbarSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/overflowBtn"
                    android:nextFocusDown="@id/netInfo"
                    android:nextFocusUp="@id/startStop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/item_focus_bg"
                    android:contentDescription="@string/menu"
                    android:scaleType="center"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="@dimen/side_padding"
            android:paddingEnd="@dimen/side_padding">

            <!-- ===================== INFO ===================== -->
            <LinearLayout
                style="@style/TasirinCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/version"
                        style="@style/TasirinInfo"
                        android:layout_width="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/uptimeInfo"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true"
                        style="@style/TasirinInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/netInfo"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:nextFocusDown="@id/startStop"
                    android:nextFocusUp="@id/overflowBtn"
                    style="@style/TasirinInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_url_box"
                    android:clickable="true"
                    android:contentDescription="@string/copy_url"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:padding="10dp" />
            </LinearLayout>

            <!-- ===================== LOG REALTIME ===================== -->
            <LinearLayout
                style="@style/TasirinCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Pratinjau log scroll mandiri (autoscroll via kode): abaikan NestedScrolling. -->
                <!-- nestedScrollingEnabled agar gulir jari di pratinjau tak berebut scroll halaman. -->
                <ScrollView
                    android:id="@+id/homeLogScroll"
                    android:nestedScrollingEnabled="true"
                    tools:ignore="NestedScrolling"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:background="@drawable/bg_info_box">

                    <TextView
                        android:id="@+id/homeLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/log_text_size" />
                </ScrollView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer sticky: banner status + Start/Stop full-width selalu terlihat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="0dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/card_stroke" />

        <LinearLayout
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_stopped"
            android:focusable="false"
            android:gravity="center_vertical|center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dot_stopped"
                android:focusable="false" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:focusable="false"
                android:text="@string/stopped"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/restartHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_changed_hint"
            android:textColor="@color/status_off"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/updateBtn"
            android:nextFocusDown="@id/startStop"
            android:nextFocusUp="@id/netInfo"
            style="@style/TasirinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/update_available_hint"
            android:visibility="gone" />

        <Button
            android:id="@+id/startStop"
            android:nextFocusDown="@id/overflowBtn"
            android:nextFocusUp="@id/netInfo"
            style="@style/TasirinBtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start" />
    </LinearLayout>
</LinearLayout>
