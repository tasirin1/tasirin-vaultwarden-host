<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vaultwarden server"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp" />

        <!-- ===================== SERVER ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Server"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder data (mis. /sdcard/vaultwarden)" />

        <EditText
            android:id="@+id/dataDir"
            android:nextFocusDown="@id/port"
            android:background="@drawable/bg_input_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/sdcard/vaultwarden"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port" />

        <EditText
            android:id="@+id/port"
            android:nextFocusDown="@id/adminToken"
            android:nextFocusUp="@id/dataDir"
            android:background="@drawable/bg_input_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="8088"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Token (kosongkan jika tidak perlu)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/adminToken"
            android:nextFocusDown="@id/autoStart"
            android:nextFocusUp="@id/port"
            android:background="@drawable/bg_input_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="admin token"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/showAdmin"
            android:nextFocusDown="@id/autoStart"
            android:nextFocusUp="@id/port"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/autoStart"
            android:nextFocusDown="@id/https"
            android:nextFocusUp="@id/adminToken"
            android:background="@drawable/item_focus_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Auto start saat boot" />

        <CheckBox
            android:id="@+id/https"
            android:nextFocusDown="@id/pinInput"
            android:nextFocusUp="@id/autoStart"
            android:background="@drawable/item_focus_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTPS (self-signed)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PIN kunci app (opsional)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pinInput"
            android:nextFocusDown="@id/batteryBtn"
            android:nextFocusUp="@id/https"
            android:background="@drawable/bg_input_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="PIN 4-6 digit"
                android:inputType="numberPassword"
                android:maxLength="6" />

            <CheckBox
                android:id="@+id/pinEnabled"
            android:nextFocusDown="@id/batteryBtn"
            android:nextFocusUp="@id/https"
            android:background="@drawable/item_focus_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktif"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/batteryBtn"
            android:nextFocusDown="@id/start"
            android:nextFocusUp="@id/pinInput"
            android:background="@drawable/bg_btn_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nonaktifkan Battery Optimization"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <!-- ===================== KONTROL ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kontrol"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
            android:nextFocusDown="@id/update"
            android:nextFocusUp="@id/batteryBtn"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start" />

            <Button
                android:id="@+id/stop"
            android:nextFocusDown="@id/revert"
            android:nextFocusUp="@id/batteryBtn"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />

            <Button
                android:id="@+id/open"
            android:nextFocusDown="@id/installCert"
            android:nextFocusUp="@id/batteryBtn"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open Web UI" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update"
            android:nextFocusDown="@id/copyUrl"
            android:nextFocusUp="@id/start"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cek Update" />

            <Button
                android:id="@+id/revert"
            android:nextFocusDown="@id/exportCfg"
            android:nextFocusUp="@id/stop"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Revert Bawaan" />

            <Button
                android:id="@+id/cert"
            android:nextFocusDown="@id/importCfg"
            android:nextFocusUp="@id/open"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sertifikat"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <Button
                android:id="@+id/installCert"
            android:nextFocusDown="@id/exportCfg"
            android:nextFocusUp="@id/open"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Install Cert"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stopped"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Info Jaringan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/netInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <Button
            android:id="@+id/copyUrl"
            android:nextFocusDown="@id/exportCfg"
            android:nextFocusUp="@id/update"
            android:background="@drawable/bg_btn_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salin URL"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/exportCfg"
            android:nextFocusDown="@id/updateWv"
            android:nextFocusUp="@id/copyUrl"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export Config"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <Button
                android:id="@+id/importCfg"
            android:nextFocusDown="@id/updateWv"
            android:nextFocusUp="@id/copyUrl"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import Config"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===================== BACKUP ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Backup"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/updateWv"
            android:nextFocusDown="@id/tgToken"
            android:nextFocusUp="@id/exportCfg"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Update Web Vault"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Button
                android:id="@+id/backupDb"
            android:nextFocusDown="@id/tgToken"
            android:nextFocusUp="@id/importCfg"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Backup DB"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Button
                android:id="@+id/restoreDb"
            android:nextFocusDown="@id/tgToken"
            android:nextFocusUp="@id/importCfg"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restore DB"
                android:textAllCaps="false"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Backup Cloud (Telegram)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/tgToken"
            android:nextFocusDown="@id/tgChat"
            android:nextFocusUp="@id/updateWv"
            android:background="@drawable/bg_input_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Bot token dari @BotFather"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/showTg"
            android:nextFocusDown="@id/tgChat"
            android:nextFocusUp="@id/updateWv"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/tgChat"
            android:nextFocusDown="@id/backupPass"
            android:nextFocusUp="@id/tgToken"
            android:background="@drawable/bg_input_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chat ID (angka)"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password enkripsi backup (opsional)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/backupPass"
            android:nextFocusDown="@id/tgAuto"
            android:nextFocusUp="@id/tgChat"
            android:background="@drawable/bg_input_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="kosongkan = tanpa enkripsi"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/showPass"
            android:nextFocusDown="@id/tgAuto"
            android:nextFocusUp="@id/tgChat"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/tgAuto"
            android:nextFocusDown="@id/backupOnStart"
            android:nextFocusUp="@id/backupPass"
            android:background="@drawable/item_focus_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup otomatis tiap 24 jam" />

        <CheckBox
            android:id="@+id/backupOnStart"
            android:nextFocusDown="@id/backupTg"
            android:nextFocusUp="@id/tgAuto"
            android:background="@drawable/item_focus_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup otomatis saat Start (maks. 1x/24 jam)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backupTg"
            android:nextFocusDown="@id/logOpen"
            android:nextFocusUp="@id/backupOnStart"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Backup ke Telegram"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <Button
                android:id="@+id/restoreTg"
            android:nextFocusDown="@id/logOpen"
            android:nextFocusUp="@id/backupOnStart"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restore dari Telegram"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===================== LOG ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Log"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/logOpen"
            android:nextFocusDown="@id/logSearch"
            android:nextFocusUp="@id/backupTg"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/logClear"
            android:nextFocusDown="@id/logSearch"
            android:nextFocusUp="@id/logOpen"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bersihkan"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/logToggle"
            android:nextFocusDown="@id/logSearch"
            android:nextFocusUp="@id/logOpen"
            android:background="@drawable/bg_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sembunyikan"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/logSearch"
            android:nextFocusDown="@id/logAutoScroll"
            android:nextFocusUp="@id/logOpen"
            android:background="@drawable/bg_input_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cari di log..."
                android:inputType="text"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/logAutoScroll"
            android:nextFocusDown="@id/logSearch"
            android:nextFocusUp="@id/logSearch"
            android:background="@drawable/item_focus_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-scroll"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10sp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
