<?xml version="1.0" encoding="utf-8"?>
            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rawatRingkasan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/rawatUbah"
                        android:nextFocusDown="@id/tgUbah"
                        android:nextFocusUp="@id/secUbah"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/ubah"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rawatDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_sistem" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/autoStart"
                    android:nextFocusDown="@id/https"
                    android:nextFocusUp="@id/pinEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_start_boot" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/https"
                    android:nextFocusDown="@id/batteryBtn"
                    android:nextFocusUp="@id/autoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/https_self_signed" />

                <TextView
                    android:id="@+id/httpsBadge"
                    style="@style/TasirinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:id="@+id/batteryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_not_allowed"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/batteryBtn"
                        android:nextFocusDown="@id/autoUpdate"
                        android:nextFocusUp="@id/https"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allow" />
                </LinearLayout>

                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_pembaruan" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/autoUpdate"
                    android:nextFocusDown="@id/autoUpdateWv"
                    android:nextFocusUp="@id/batteryBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_update_binary" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/autoUpdateWv"
                    android:nextFocusDown="@id/autoRestart"
                    android:nextFocusUp="@id/autoUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_update_webvault" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/autoRestart"
                    android:nextFocusDown="@id/update"
                    android:nextFocusUp="@id/autoUpdateWv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_restart_update" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/update"
                        android:nextFocusDown="@id/revert"
                        android:nextFocusLeft="@id/update"
                        android:nextFocusRight="@id/revert"
                        android:nextFocusUp="@id/autoRestart"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/check_update" />

                    <Button
                        android:id="@+id/revert"
                        android:nextFocusDown="@id/installCert"
                        android:nextFocusLeft="@id/update"
                        android:nextFocusRight="@id/revert"
                        android:nextFocusUp="@id/update"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/reset_binary" />
                </LinearLayout>

                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_sertifikat" />

                <TextView
                    style="@style/TasirinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cert_hint_singkat" />

                <Button
                    android:id="@+id/certInfoToggle"
                    android:nextFocusDown="@id/installCert"
                    android:nextFocusUp="@id/revert"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cert_info_buka" />

                <TextView
                    android:id="@+id/certHint"
                    style="@style/TasirinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cert_hint"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/installCert"
                        android:nextFocusDown="@id/shareCa"
                        android:nextFocusLeft="@id/installCert"
                        android:nextFocusRight="@id/shareCa"
                        android:nextFocusUp="@id/certInfoToggle"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/install_cert" />

                    <Button
                        android:id="@+id/shareCa"
                        android:nextFocusDown="@id/resetCert"
                        android:nextFocusLeft="@id/installCert"
                        android:nextFocusRight="@id/shareCa"
                        android:nextFocusUp="@id/installCert"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/share_ca" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/resetCert"
                        android:nextFocusDown="@id/backupCa"
                        android:nextFocusLeft="@id/resetCert"
                        android:nextFocusRight="@id/backupCa"
                        android:nextFocusUp="@id/shareCa"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reset_cert" />

                    <Button
                        android:id="@+id/backupCa"
                        android:nextFocusDown="@id/exportCfg"
                        android:nextFocusLeft="@id/resetCert"
                        android:nextFocusRight="@id/backupCa"
                        android:nextFocusUp="@id/resetCert"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/backup_ca_storage" />
                </LinearLayout>

                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_konfigurasi" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <Button
                        android:id="@+id/exportCfg"
                        android:nextFocusDown="@id/importCfg"
                        android:nextFocusLeft="@id/exportCfg"
                        android:nextFocusRight="@id/importCfg"
                        android:nextFocusUp="@id/backupCa"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/export_config" />

                    <Button
                        android:id="@+id/importCfg"
                        android:nextFocusDown="@id/updateWv"
                        android:nextFocusLeft="@id/exportCfg"
                        android:nextFocusRight="@id/importCfg"
                        android:nextFocusUp="@id/exportCfg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/import_config" />
                    </LinearLayout>

                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_db" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <Button
                        android:id="@+id/updateWv"
                        android:nextFocusDown="@id/restoreDb"
                        android:nextFocusLeft="@id/updateWv"
                        android:nextFocusRight="@id/restoreDb"
                        android:nextFocusUp="@id/importCfg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/update_web_vault" />

                    <Button
                        android:id="@+id/restoreDb"
                        android:nextFocusDown="@id/tgToken"
                        android:nextFocusLeft="@id/updateWv"
                        android:nextFocusRight="@id/restoreDb"
                        android:nextFocusUp="@id/updateWv"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/restore_db" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
