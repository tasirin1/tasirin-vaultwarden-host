<?xml version="1.0" encoding="utf-8"?>
            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tgRingkasan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/tgUbah"
                        android:drawableStart="@drawable/ic_edit"
                        android:drawablePadding="8dp"
                        android:nextFocusDown="@id/logOpen"
                        android:nextFocusUp="@id/rawatUbah"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/ubah"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tgDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_tg_kredensial" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/bot_token" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/tgToken"
                        android:nextFocusDown="@id/showTg"
                        android:nextFocusUp="@id/restoreDb"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/bot_token_hint"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/showTg"
                        android:drawableStart="@drawable/ic_eye"
                        android:drawablePadding="8dp"
                        android:nextFocusDown="@id/copyTg"
                        android:nextFocusUp="@id/tgToken"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/show" />
                </LinearLayout>

                <Button
                    android:id="@+id/copyTg"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="8dp"
                    android:nextFocusDown="@id/tgChat"
                    android:nextFocusUp="@id/showTg"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/copy" />

                <TextView
                    android:id="@+id/tokenError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/token_error"
                    android:textColor="@color/status_off"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_id" />

                <EditText
                    android:id="@+id/tgChat"
                    android:nextFocusDown="@id/backupPass"
                    android:nextFocusUp="@id/copyTg"
                    style="@style/TasirinInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/chat_id_hint"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/chatError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_error"
                    android:textColor="@color/status_off"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tgStatus"
                    style="@style/TasirinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_pass_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/backupPass"
                        android:nextFocusDown="@id/showPass"
                        android:nextFocusUp="@id/tgChat"
                        style="@style/TasirinInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textPassword" />

                    <Button
                        android:id="@+id/showPass"
                        android:nextFocusDown="@id/binSha"
                        android:nextFocusUp="@id/backupPass"
                        style="@style/TasirinBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/show" />
                </LinearLayout>

                <TextView
                    style="@style/TasirinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bin_sha_label" />

                <EditText
                    android:id="@+id/binSha"
                    android:nextFocusDown="@id/tgAuto"
                    android:nextFocusUp="@id/showPass"
                    style="@style/TasirinInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/bin_sha_hint"
                    android:inputType="text" />

                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_tg_otomatis" />

                <CheckBox
                    style="@style/TasirinCheck"
                    android:id="@+id/tgAuto"
                    android:nextFocusDown="@id/backupDb"
                    android:nextFocusUp="@id/binSha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_auto_24h" />


                <View style="@style/TasirinDivider" />

                <TextView
                    style="@style/TasirinSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_tg_aksi" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/backupDb"
                        android:drawableStart="@drawable/ic_save"
                        android:drawablePadding="8dp"
                        android:nextFocusDown="@id/backupTg"
                        android:nextFocusUp="@id/tgAuto"
                        style="@style/TasirinBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_local" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <Button
                        android:id="@+id/backupTg"
                        android:drawableStart="@drawable/ic_send"
                        android:drawablePadding="8dp"
                        android:nextFocusDown="@id/restoreTg"
                        android:nextFocusLeft="@id/backupTg"
                        android:nextFocusRight="@id/restoreTg"
                        android:nextFocusUp="@id/backupDb"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_to_tg" />

                    <Button
                        android:id="@+id/restoreTg"
                        android:drawableStart="@drawable/ic_history"
                        android:drawablePadding="8dp"
                        android:nextFocusDown="@id/logOpen"
                        android:nextFocusLeft="@id/backupTg"
                        android:nextFocusRight="@id/restoreTg"
                        android:nextFocusUp="@id/backupTg"
                        style="@style/TasirinBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/restore_from_tg" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tg_bot_info"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
