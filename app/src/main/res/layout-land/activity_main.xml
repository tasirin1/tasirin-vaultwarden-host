<?xml version="1.0" encoding="utf-8"?>
<!-- Layar awal landscape: hero + dua kolom (kiri: log penuh 60%,
     kanan: tautan di atas + server di bawah) + footer Start sticky. ID sama persis dengan portrait
     agar MainActivity tidak berubah. Rantai nextFocus*: vertikal kolom kiri
     dulu lalu kolom kanan, plus kiri/kanan antar-kolom untuk D-pad TV.
     Padding kartu 12dp (bukan 16dp) agar hemat tinggi layar; margin tepi
     layar lebar diatur values-sw600dp-land (bukan 200dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/side_padding"
    android:paddingEnd="@dimen/side_padding"
    android:paddingTop="8dp">

    <!-- Hero ringkas satu baris -->
    <LinearLayout
        android:id="@+id/heroBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:focusable="false"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/appTitle"
            style="@style/TasirinHeroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:scrollHorizontally="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <Button
            android:id="@+id/overflowBtn"
            android:nextFocusDown="@id/logToggle"
            android:nextFocusUp="@id/startStop"
            style="@style/TasirinBtnHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/menu"
            android:text="@string/overflow" />
    </LinearLayout>

    <!-- Dua kolom: kiri log realtime full (panel utama), kanan tautan + server -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        tools:ignore="NestedWeights">

        <!-- Kolom kiri: log realtime penuh (60% lebar agar muat banyak baris di TV) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <LinearLayout
            style="@style/TasirinCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TasirinSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/log_realtime" />

                <Button
                    android:id="@+id/logToggle"
                    android:nextFocusDown="@id/homeSaveLog"
                    android:nextFocusLeft="@id/netInfo"
                    android:nextFocusRight="@id/homeSaveLog"
                    android:nextFocusUp="@id/overflowBtn"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collapse" />

                <Button
                    android:id="@+id/homeSaveLog"
                    android:nextFocusDown="@id/startStop"
                    android:nextFocusLeft="@id/logToggle"
                    android:nextFocusRight="@id/netInfo"
                    android:nextFocusUp="@id/logToggle"
                    style="@style/TasirinBtnSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/save_txt" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeLogCount"
                    android:maxLines="1"
                    android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/log_lines_initial"
                android:textSize="@dimen/log_count_size" />

            <ScrollView
                android:id="@+id/homeLogScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_info_box">

                <TextView
                    android:id="@+id/homeLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/log_text_size" />
            </ScrollView>

        </LinearLayout>
        </LinearLayout>

        <!-- Kolom kanan: kartu tautan di atas + status server di bawah (gulir di layar pendek) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                    <LinearLayout
                    style="@style/TasirinCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/version"
                        style="@style/TasirinInfo"
                        android:layout_width="match_parent"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/netInfo"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:nextFocusDown="@id/updateBtn"
                        android:nextFocusLeft="@id/logToggle"
                        android:nextFocusUp="@id/overflowBtn"
                        style="@style/TasirinInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_url_box"
                        android:clickable="true"
                        android:contentDescription="@string/copy_url"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:padding="10dp" />

                    <TextView
                        android:id="@+id/uptimeInfo"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:scrollHorizontally="true"
                        style="@style/TasirinInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                    <LinearLayout
                    style="@style/TasirinCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/TasirinSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/server_title" />

                    <LinearLayout
                        android:id="@+id/statusBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_status_stopped"
                        android:focusable="false"
                        android:gravity="center_vertical|center_horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_dot_stopped"
                            android:focusable="false" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:text="@string/stopped"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/restartHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_changed_hint"
                        android:textColor="@color/status_off"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/updateBtn"
                        android:nextFocusDown="@id/startStop"
                        android:nextFocusLeft="@id/logToggle"
                        android:nextFocusUp="@id/netInfo"
                        style="@style/TasirinBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/update_available_hint"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Footer sticky: Start full-width selalu terlihat (wadah sama dengan portrait) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="0dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/card_stroke" />

        <Button
            android:id="@+id/startStop"
            android:nextFocusDown="@id/overflowBtn"
            android:nextFocusUp="@id/homeSaveLog"
            style="@style/TasirinBtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start" />
    </LinearLayout>
</LinearLayout>
