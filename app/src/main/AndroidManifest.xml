<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Izin storage untuk semua Android agar folder data eksternal
         (/sdcard/vaultwarden) tetap writable. maxSdkVersion sengaja
         tidak dipakai: di Android 10+ tanpa deklarasi ini folder
         eksternal gagal dibuat/ditulis. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Android 11+ (API 30+): akses /storage/emulated/0 butuh All files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Aplikasi dipakai di TV (tanpa layar sentuh): jangan wajibkan touchscreen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- usesCleartextTraffic=false: server selalu HTTPS (HTTPS-only) dan
         Telegram/GitHub selalu HTTPS (https hardcode, redirect http ditolak),
         sehingga cleartext tak dibutuhkan sama sekali. Flag true membuka
         cleartext WAN di API 23 (network_security_config baru berlaku API 24+).
         Loopback HTTP tetap diizinkan eksplisit di network_security_config
         untuk API 24+ bila sewaktu-waktu dibutuhkan. -->
    <application
        android:allowBackup="false"
        android:supportsRtl="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.TasirinVaultwardenHost.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.TasirinVaultwardenHost" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.TasirinVaultwardenHost" />

        <service
            android:name=".ServerService"
            android:exported="false" />

        <!-- exported=true: DATE_CHANGED/TIME_SET/TIMEZONE_CHANGED adalah
             protected broadcast (hanya sistem yang bisa mengirim); dengan
             exported=false sistem tak bisa menyampaikan di Android 12+.
             Alarm eksplisit milik app (explicit intent) tetap sampai apa pun
             nilainya. Pemicu asing aman: mulaiBackup cek auto + token/chat. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TgBotReceiver"
            android:exported="false" />

        <provider
            android:name=".FileShareProvider"
            android:authorities="com.tasirin.vaultwardenhost.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- exported=true: BOOT_COMPLETED/QUICKBOOT/MY_PACKAGE_REPLACED adalah
             protected broadcast (hanya sistem yang bisa mengirim), dan contoh
             resmi mewajibkan exported agar sampai di Android modern. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
